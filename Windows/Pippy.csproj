<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Version>0.5.0</Version>
    <AssemblyName>Pippy</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Assets/*.png" Link="Assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Assets/Sounds/*.wav" Link="Assets/Sounds/%(Filename)%(Extension)" />
    <EmbeddedResource Include="AppIcon.ico" />
  </ItemGroup>
</Project>
